---
// Inline SVG icons. 24px grid, 1.5 stroke, drawn to match the grotesk's weight.
interface Props {
  name:
    | 'mail' | 'github' | 'linkedin' | 'download' | 'arrow-up-right' | 'sun' | 'moon'
    | 'database' | 'server' | 'ai' | 'events' | 'cluster' | 'chip' | 'api' | 'cloud';
}
const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width="16"
  height="16"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
>
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" />
        <path d="M3 6l9 7 9-7" />
      </>
    )
  }
  {name === 'download' && <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />}
  {name === 'arrow-up-right' && <path d="M8 16L16 8M9 8h7v7" />}
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
      </>
    )
  }
  {
    name === 'database' && (
      <>
        <ellipse cx="12" cy="5.5" rx="7" ry="2.5" />
        <path d="M5 5.5v13c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-13M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5" />
      </>
    )
  }
  {
    name === 'server' && (
      <>
        <rect x="3.5" y="4" width="17" height="7" />
        <rect x="3.5" y="13" width="17" height="7" />
        <circle cx="7.5" cy="7.5" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="7.5" cy="16.5" r="0.9" fill="currentColor" stroke="none" />
        <path d="M11.5 7.5h5M11.5 16.5h5" />
      </>
    )
  }
  {
    name === 'ai' && (
      <path stroke-linejoin="round" d="M10 3.5l1.9 5.1 5.1 1.9-5.1 1.9L10 17.5l-1.9-5.1L3 10.5l5.1-1.9zM18 14.5v6M15 17.5h6" />
    )
  }
  {name === 'events' && <path stroke-linejoin="round" d="M13.5 2.5L5 13.5h6.5l-1 8 8.5-11h-6.5z" />}
  {
    name === 'cluster' && (
      <>
        <circle cx="12" cy="5" r="2.5" />
        <circle cx="5" cy="18.5" r="2.5" />
        <circle cx="19" cy="18.5" r="2.5" />
        <path d="M10.8 7.2L6.2 16.3M13.2 7.2l4.6 9.1M7.5 18.5h9" />
      </>
    )
  }
  {
    name === 'chip' && (
      <>
        <rect x="6.5" y="6.5" width="11" height="11" />
        <rect x="10" y="10" width="4" height="4" />
        <path d="M10 3v3.5M14 3v3.5M10 17.5V21M14 17.5V21M3 10h3.5M3 14h3.5M17.5 10H21M17.5 14H21" />
      </>
    )
  }
  {name === 'api' && <path stroke-linejoin="round" d="M8 4H7a2 2 0 0 0-2 2v3.5L3 12l2 2.5V18a2 2 0 0 0 2 2h1M16 4h1a2 2 0 0 1 2 2v3.5l2 2.5-2 2.5V18a2 2 0 0 1-2 2h-1" />}
  {
    name === 'cloud' && (
      <path stroke-linejoin="round" d="M7 18.5h10.5a4 4 0 0 0 .6-7.95A5.5 5.5 0 0 0 7.4 9.1 4.75 4.75 0 0 0 7 18.5z" />
    )
  }
  {name === 'moon' && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />}
  {
    name === 'github' && (
      <path
        fill="currentColor"
        stroke="none"
        d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49l-.01-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9l-.01 2.81c0 .27.18.6.69.49A10.1 10.1 0 0 0 22 12.23C22 6.58 17.52 2 12 2z"
      />
    )
  }
  {
    name === 'linkedin' && (
      <path
        fill="currentColor"
        stroke="none"
        d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
      />
    )
  }
</svg>
