---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import Icon from './Icon.astro';
import { copy, person, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const other: Lang = lang === 'en' ? 'pt' : 'en';
const otherHref = other === 'pt' ? '/pt/' : '/';
---

<div class="controls">
  <a class="ctl mono" href={otherHref} hreflang={copy[other].htmlLang} lang={copy[other].htmlLang}
    >{t.langSwitch.short}<span class="visually-hidden"> – {t.langSwitch.label}</span></a
  >
  <button
    class="ctl theme-toggle"
    type="button"
    aria-pressed="false"
    data-label-dark={t.theme.toDark}
    data-label-light={t.theme.toLight}
    aria-label={t.theme.toDark}
  >
    <span class="i-moon"><Icon name="moon" /></span>
    <span class="i-sun"><Icon name="sun" /></span>
  </button>
</div>

<main class="page">
  <article class="hero" aria-labelledby="name">
    <div class="copy">
      <h1 id="name">Danilo<br /><span class="surname">Sambugaro</span></h1>
      <p class="role">{t.role}</p>
      <p class="country mono"><span class="power" aria-hidden="true"></span>{t.country}</p>
      <p class="intro">{t.intro}</p>
      <nav class="links" aria-label={t.linksLabel}>
        <a class="btn btn-primary" href={person.linkedin} target="_blank" rel="me noopener noreferrer">
          <Icon name="linkedin" />LinkedIn<span class="visually-hidden"> ({t.newTab})</span>
          <Icon name="arrow-up-right" />
        </a>
        <a class="text-link" href={person.github} target="_blank" rel="me noopener noreferrer">
          <Icon name="github" /><span class="label">GitHub</span><span class="visually-hidden">
            ({t.newTab})</span
          >
          <Icon name="arrow-up-right" />
        </a>
      </nav>
    </div>
    <button class="portrait" type="button" aria-pressed="false" aria-label={t.joy}>
      <Image
        src={avatar}
        alt=""
        widths={[320, 640]}
        sizes="(min-width: 50rem) 22rem, 70vw"
        loading="eager"
        fetchpriority="high"
      />
    </button>
  </article>
</main>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : media.matches);

  const sync = () => {
    if (!btn) return;
    const dark = isDark();
    btn.setAttribute('aria-pressed', String(dark));
    btn.setAttribute('aria-label', (dark ? btn.dataset.labelLight : btn.dataset.labelDark) ?? '');
  };

  btn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });
  media.addEventListener('change', sync);
  sync();

  // Easter egg: clicking the portrait spins it, colours it and turns on party mode.
  const portrait = document.querySelector<HTMLButtonElement>('.portrait');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const confettiColors = ['#e96a26', '#f5c518', '#2b59c3', '#2a9d8f', '#e4577b'];

  const confetti = (from: DOMRect) => {
    const canvas = document.createElement('canvas');
    canvas.className = 'confetti';
    canvas.setAttribute('aria-hidden', 'true');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = innerWidth * dpr;
    canvas.height = innerHeight * dpr;
    document.body.append(canvas);
    const ctx = canvas.getContext('2d');
    if (!ctx) return canvas.remove();
    ctx.scale(dpr, dpr);

    const cx = from.left + from.width / 2;
    const cy = from.top + from.height / 2;
    const pieces = Array.from({ length: 140 }, () => {
      const angle = Math.random() * Math.PI * 2;
      const speed = 4 + Math.random() * 9;
      return {
        x: cx,
        y: cy,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed - 6,
        w: 5 + Math.random() * 6,
        h: 8 + Math.random() * 8,
        r: Math.random() * Math.PI,
        vr: (Math.random() - 0.5) * 0.4,
        color: confettiColors[(Math.random() * confettiColors.length) | 0],
      };
    });

    const start = performance.now();
    const duration = 2200;
    const frame = (now: number) => {
      const t = now - start;
      ctx.clearRect(0, 0, innerWidth, innerHeight);
      ctx.globalAlpha = Math.max(0, 1 - Math.max(0, t - duration * 0.6) / (duration * 0.4));
      for (const p of pieces) {
        p.vx *= 0.985;
        p.vy = p.vy * 0.985 + 0.32;
        p.x += p.vx;
        p.y += p.vy;
        p.r += p.vr;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.r);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h * Math.abs(Math.cos(p.r * 2)));
        ctx.restore();
      }
      if (t < duration) requestAnimationFrame(frame);
      else canvas.remove();
    };
    requestAnimationFrame(frame);
  };

  portrait?.addEventListener('click', () => {
    const on = root.dataset.joy !== 'on';
    if (on) root.dataset.joy = 'on';
    else delete root.dataset.joy;
    portrait.setAttribute('aria-pressed', String(on));

    if (calm.matches) return;
    portrait.classList.remove('spin');
    void portrait.offsetWidth; // restart the animation on repeated clicks
    portrait.classList.add('spin');
    if (on) confetti(portrait.getBoundingClientRect());
  });
  portrait?.addEventListener('animationend', () => portrait.classList.remove('spin'));
</script>

<style>
  /* Controls */
  .controls {
    position: absolute;
    top: max(var(--s-4), env(safe-area-inset-top));
    right: max(var(--gutter), env(safe-area-inset-right));
    display: flex;
    gap: var(--s-2);
  }
  .ctl {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    height: 44px;
    padding: 0 var(--s-2);
    border: 1px solid var(--muted);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink-2);
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) linear,
      color var(--dur-fast) linear;
  }
  @media (hover: hover) {
    .ctl:hover {
      border-color: var(--ink);
      color: var(--ink);
    }
  }
  .theme-toggle span {
    display: grid;
  }
  .theme-toggle .i-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .i-sun {
    display: grid;
  }
  :global(:root[data-theme='dark']) .theme-toggle .i-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .i-sun {
      display: grid;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle .i-moon {
      display: none;
    }
  }

  /* Page: one screen, content centred vertically. */
  .page {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: var(--s-24) max(var(--gutter), env(safe-area-inset-right)) var(--s-16)
      max(var(--gutter), env(safe-area-inset-left));
  }
  .hero {
    width: 100%;
    max-width: 68rem;
    margin-inline: auto;
    display: grid;
    gap: var(--s-12);
  }
  @media (min-width: 50rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: center;
      gap: var(--s-16);
    }
  }

  h1 {
    font-size: clamp(3.25rem, 1.6rem + 6.4vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .surname {
    transition: color 600ms var(--ease-out);
  }
  :global(:root[data-joy='on']) .surname {
    color: var(--name-2);
  }
  .role {
    margin-top: var(--s-6);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .country {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-3);
    color: var(--muted);
  }
  /* The single signal colour on the page. */
  .power {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    animation: power-on 120ms linear 350ms both;
  }
  @keyframes power-on {
    from {
      background: var(--line);
    }
  }
  .intro {
    margin-top: var(--s-8);
    max-width: 34rem;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.3125rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-8);
    margin-top: var(--s-8);
  }
  .links :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }
  .links a :global(svg:last-child) {
    width: 0.875rem;
    height: 0.875rem;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    font-weight: 500;
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .text-link .label {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--dur-fast) linear;
  }
  @media (hover: hover) {
    .text-link:hover .label {
      text-decoration-color: var(--ink);
    }
  }

  /* Portrait: grayscale. Clicking it (easter egg) spins it and turns on party mode. */
  .portrait {
    display: block;
    width: min(100%, 18rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    cursor: pointer;
    perspective: 900px;
    -webkit-tap-highlight-color: transparent;
  }
  @media (min-width: 50rem) {
    .portrait {
      width: 100%;
    }
  }
  .portrait img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    filter: grayscale(1) contrast(1.05);
    transition:
      filter 500ms var(--ease-out) 250ms,
      border-radius 500ms var(--ease-out);
  }
  .portrait.spin img {
    animation: spin 900ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  @keyframes spin {
    to {
      transform: rotateY(360deg);
    }
  }
  :global(:root[data-joy='on']) .portrait img {
    filter: saturate(1.15);
    border-radius: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .power {
      animation: none;
    }
    .portrait img {
      transition: none;
    }
  }
</style>
