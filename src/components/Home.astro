---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import Icon from './Icon.astro';
import { careerStart, copy, fullYearsSince, person, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const other: Lang = lang === 'en' ? 'pt' : 'en';
const otherHref = other === 'pt' ? '/pt/' : '/';
const [first, ...rest] = t.intro;
const [introBefore, introAfter] = first.split('{years}');
const links = [
  { name: 'LinkedIn', handle: '/in/dsambugaro', href: person.linkedin, icon: 'linkedin' as const, pos: 'li' },
  { name: 'GitHub', handle: '@dsambugaro', href: person.github, icon: 'github' as const, pos: 'gh' },
];
const areas = Object.entries(t.areas) as [keyof typeof t.areas, string][];
---

<div class="controls">
  <a class="ctl mono" href={otherHref} hreflang={copy[other].htmlLang} lang={copy[other].htmlLang}
    >{t.langSwitch.short}<span class="visually-hidden"> – {t.langSwitch.label}</span></a
  >
  <button
    class="ctl theme-toggle"
    type="button"
    aria-pressed="false"
    data-label-dark={t.theme.toDark}
    data-label-light={t.theme.toLight}
    aria-label={t.theme.toDark}
  >
    <span class="i-moon"><Icon name="moon" /></span>
    <span class="i-sun"><Icon name="sun" /></span>
  </button>
</div>

<main class="page">
  <canvas class="graph" aria-hidden="true"></canvas>
  <!-- Area icons. The graph script scatters them over the graph. -->
  <div class="areas" aria-hidden="true">
  {
    areas.map(([icon, label]) => (
      <span class={`node node-area area-${icon}`} aria-hidden="true">
        <span class="ring">
          <Icon name={icon} />
        </span>
        <span class="label mono">{label}</span>
      </span>
    ))
  }
  </div>

  <article class="copy" aria-labelledby="name">
    <div class="code mono" aria-hidden="true">
      <div><span class="k">const</span> <span class="v">career</span> <span class="p">=</span> <span class="k">await</span> <span class="f">build</span><span class="p">(</span><span class="v">systems</span><span class="p">)</span></div>
      <div class="indent"><span class="p">.</span><span class="f">then</span><span class="p">(</span><span class="v">scale</span><span class="p">)</span></div>
      <div class="indent"><span class="p">.</span><span class="f">catch</span><span class="p">(</span><span class="v">learn</span><span class="p">);</span><span class="cursor"></span></div>
    </div>

    <h1 id="name">Danilo <span class="surname">Sambugaro</span></h1>
    <p class="role mono">
      <span class="title"
        >{t.role.split(' ').map((w, i) => (
          <>
            {i > 0 && ' '}
            <span class="word">{w}</span>
          </>
        ))}</span
      ><span class="country">{t.country}</span>
    </p>
    <div class="intro">
      <p>
        {introBefore}<span
          class="years"
          data-start-year={careerStart.year}
          data-start-month={careerStart.month}>{fullYearsSince()}</span
        >{introAfter}
      </p>
      {rest.map((p) => <p>{p}</p>)}
    </div>
    <p class="tags mono">
      {t.tags.map((tag, i) => (
        <>
          {i > 0 && <span class="slash" aria-hidden="true">/</span>}
          <span>{tag}</span>
        </>
      ))}
    </p>
  </article>

  <div class="stage">
    <button class="node node-avatar" type="button" aria-label={t.portrait}>
      <span class="ring">
        <Image
          src={avatar}
          alt=""
          widths={[256, 512]}
          sizes="13rem"
          loading="eager"
          fetchpriority="high"
        />
      </span>
    </button>
    <nav aria-label={t.linksLabel}>
      {
        links.map((l) => (
          <a class={`node node-link node-${l.pos}`} data-tone="lime" href={l.href} target="_blank" rel="me noopener noreferrer">
            <span class="ring">
              <Icon name={l.icon} />
            </span>
            <span class="label mono">
              <span class="name">{l.name}</span>
              <span class="handle">{l.handle}</span>
              <span class="visually-hidden"> ({t.newTab})</span>
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</main>

<script>
  import { startGraph } from '../scripts/graph';
  import { smokeAndSparks, sparksOnly } from '../scripts/breakdown';

  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : media.matches);

  const sync = () => {
    if (!btn) return;
    const dark = isDark();
    btn.setAttribute('aria-pressed', String(dark));
    btn.setAttribute('aria-label', (dark ? btn.dataset.labelLight : btn.dataset.labelDark) ?? '');
  };

  btn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });
  media.addEventListener('change', sync);
  sync();

  // "More than N years": recomputed here so the number stays right without a rebuild.
  const years = document.querySelector<HTMLElement>('.years');
  if (years) {
    const now = new Date();
    const n =
      now.getFullYear() -
      Number(years.dataset.startYear) -
      (now.getMonth() < Number(years.dataset.startMonth) ? 1 : 0);
    years.textContent = String(n);
  }

  // The graph. The portrait and the links are nodes of it.
  const page = document.querySelector<HTMLElement>('.page');
  const canvas = document.querySelector<HTMLCanvasElement>('.graph');
  const text = document.querySelector<HTMLElement>('.copy');
  const portrait = document.querySelector<HTMLButtonElement>('.node-avatar');
  const specials = [portrait, ...document.querySelectorAll<HTMLElement>('.node-link, .node-area')].filter(
    (el): el is HTMLElement => !!el,
  );
  // Mouse wheel over the portrait zooms it between ZOOM_MIN and ZOOM_MAX times its
  // size. Dragging it and letting go springs it back to its normal size.
  const ZOOM_MIN = 0.5;
  const ZOOM_MAX = 2;
  let zoom = 1;
  const setZoom = (value: number, release = false) => {
    if (!portrait) return;
    zoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, value));
    portrait.classList.toggle('unzoom', release);
    portrait.style.setProperty('--zoom', zoom.toFixed(3));
  };
  portrait?.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault(); // zoom instead of scrolling the page
      const lines = e.deltaMode === 1 ? 33 : e.deltaMode === 2 ? 400 : 1;
      setZoom(zoom * Math.exp(-e.deltaY * lines * 0.0015));
    },
    { passive: false },
  );

  const graph =
    page && canvas && text
      ? startGraph({
          canvas,
          root: page,
          text,
          specials,
          onDragEnd: (el) => el === portrait && zoom !== 1 && setZoom(1, true),
        })
      : null;

  // Easter egg: clicking the portrait makes it pulse, sends a colour wave through the
  // graph and switches the accent colour: lime, cyan, magenta. The links take the new
  // colour when the wave reaches them.
  //
  // Click it BREAK_CLICKS times within BREAK_WINDOW ms and it "breaks": it shakes and
  // smokes, sparks fly, and the graph and the coloured text keep all three colours
  // (in a random order) until the page is reloaded.
  const BREAK_CLICKS = 10;
  const BREAK_WINDOW = 2500;
  const accents = ['lime', 'cyan', 'magenta'];
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const clicks: number[] = [];
  let broken = false;

  // The links start with whatever accent the page loaded with.
  document
    .querySelectorAll<HTMLElement>('.node-link')
    .forEach((el) => (el.dataset.tone = root.dataset.accent ?? 'lime'));

  const tones = (dark: boolean) =>
    accents.map((a) => getComputedStyle(root).getPropertyValue(`--tone-${a}`).trim() || (dark ? '#fff' : '#000'));

  const restart = (el: Element, className: string) => {
    el.classList.remove(className);
    void (el as HTMLElement).offsetWidth; // restart the animation on repeated clicks
    el.classList.add(className);
  };

  const shuffled = () => [...accents].sort(() => Math.random() - 0.5);

  const breakDown = () => {
    broken = true;
    root.dataset.broken = '';
    graph?.freeze();
    // One colour per word of the role, and per coloured bit of the code line.
    const paint = (els: HTMLElement[], prop: 'color' | 'background') => {
      const order = shuffled();
      els.forEach((el, i) => (el.style[prop] = `var(--text-${order[i % order.length]})`));
    };
    paint([...document.querySelectorAll<HTMLElement>('.role .word')], 'color');
    const code = [...document.querySelectorAll<HTMLElement>('.code .k')];
    const cursor = document.querySelector<HTMLElement>('.cursor');
    const order = shuffled();
    code.forEach((el, i) => (el.style.color = `var(--text-${order[i]})`));
    if (cursor) cursor.style.background = `var(--text-${order[code.length % 3]})`;
    if (!portrait || calm.matches) return;
    portrait.classList.remove('pulse');
    restart(portrait, 'broken');
    smokeAndSparks(portrait.querySelector('.ring') ?? portrait, tones(isDark()), isDark());
  };

  portrait?.addEventListener('click', () => {
    if (broken) {
      // Already broken: only a few sparks.
      if (!calm.matches) {
        restart(portrait, 'broken');
        sparksOnly(portrait.querySelector('.ring') ?? portrait, tones(isDark()), isDark());
      }
      return;
    }
    const now = performance.now();
    clicks.push(now);
    while (clicks.length && clicks[0] < now - BREAK_WINDOW) clicks.shift();
    if (clicks.length >= BREAK_CLICKS) return breakDown();

    const current = accents.indexOf(root.dataset.accent ?? 'lime');
    const next = accents[(current + 1) % accents.length];
    if (next === 'lime') delete root.dataset.accent;
    else root.dataset.accent = next;
    graph?.pulse(next);
    if (!calm.matches) restart(portrait, 'pulse');
  });
  portrait?.addEventListener('animationend', (e) => {
    if (e.animationName.includes('ripple')) portrait.classList.remove('pulse');
    if (e.animationName.includes('shake')) portrait.classList.remove('broken');
  });

  // Enter or Space anywhere on the page does the same as clicking the portrait,
  // unless focus is on something that already uses those keys.
  document.addEventListener('keydown', (e) => {
    if ((e.key !== 'Enter' && e.key !== ' ') || e.repeat || e.altKey || e.ctrlKey || e.metaKey) return;
    const el = e.target as HTMLElement | null;
    if (el?.closest('a, button, input, textarea, select, summary, [contenteditable]')) return;
    e.preventDefault(); // Space would scroll the page
    portrait?.click();
  });
</script>

<style>
  /* Controls */
  .controls {
    position: absolute;
    z-index: 2;
    top: max(var(--s-4), env(safe-area-inset-top));
    right: max(var(--gutter), env(safe-area-inset-right));
    display: flex;
    gap: var(--s-2);
  }
  .ctl {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    height: 44px;
    padding: 0 var(--s-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    color: var(--ink-2);
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) linear,
      color var(--dur-fast) linear;
  }
  @media (hover: hover) {
    .ctl:hover {
      border-color: var(--ink);
      color: var(--ink);
    }
  }
  .theme-toggle span {
    display: grid;
  }
  .theme-toggle .i-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .i-sun {
    display: grid;
  }
  :global(:root[data-theme='dark']) .theme-toggle .i-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .i-sun {
      display: grid;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle .i-moon {
      display: none;
    }
  }

  /* Page: one screen on desktop. Text on the left, graph on the right (like the
     LinkedIn cover). Stacked on small screens, graph first. */
  .page {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: var(--s-8);
    padding: var(--s-16) max(var(--gutter), env(safe-area-inset-right)) var(--s-12)
      max(var(--gutter), env(safe-area-inset-left));
  }
  .graph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .copy,
  /* The stage box sits over the area icons; only its nodes take the pointer, so
     icons under its empty space still get hover. */
  .stage {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }
  .stage .node {
    pointer-events: auto;
  }
  .stage {
    order: -1;
    height: 21rem;
    --avatar: clamp(9rem, 37vw, 11rem);
  }
  @media (min-width: 56rem) {
    .page {
      grid-template-columns: minmax(0, 34rem) minmax(0, 60rem);
      justify-content: center;
      align-items: center;
      gap: clamp(var(--s-16), 7vw, 10rem);
      padding-block: var(--s-16);
    }
    .stage {
      order: 0;
      height: clamp(26rem, 72svh, 44rem);
      --avatar: clamp(11.5rem, 17vw, 15.5rem);
    }
  }

  /* Code line, as on the cover */
  .code {
    font-size: clamp(0.875rem, 0.8rem + 0.35vw, 1.0625rem);
    line-height: 1.6;
    white-space: pre;
    color: var(--ink-2);
  }
  .code .indent {
    padding-left: 2ch;
  }
  .code .k {
    color: var(--accent);
  }
  .code .f {
    color: var(--ink);
    font-weight: 600;
  }
  .code .p {
    color: var(--muted);
  }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    margin-left: 0.15em;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  h1 {
    margin-top: var(--s-8);
    font-size: clamp(2.75rem, 1.6rem + 4.4vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .surname {
    display: block;
    color: var(--ink-2);
  }
  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-4);
    margin-top: var(--s-6);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .role .title {
    color: var(--accent);
    font-weight: 500;
  }
  .role .country {
    color: var(--muted);
  }
  .intro {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-6);
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.6;
    color: var(--ink-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin-top: var(--s-8);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .tags .slash {
    color: var(--line);
  }

  /* Graph nodes made of DOM elements. --x/--y place them in the stage; the graph
     script adds a small drift through --dx/--dy. */
  .node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(calc(-50% + var(--dx, 0px)), calc(-50% + var(--dy, 0px)));
    color: var(--ink-2);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .ring {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);
    transition:
      border-color var(--dur-fast) linear,
      color var(--dur-fast) linear,
      box-shadow 200ms var(--ease-out);
  }

  .node-avatar {
    --x: 30%;
    --y: 50%;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .node-avatar .ring {
    width: var(--avatar);
    height: var(--avatar);
    scale: var(--zoom, 1); /* mouse wheel zoom, set by the script */
    transition:
      scale 140ms var(--ease-out),
      border-color var(--dur-fast) linear,
      box-shadow 200ms var(--ease-out);
    padding: 5px;
    border: 2px solid var(--accent-graph);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent-graph) 12%, transparent);
  }
  .node-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  /* Back to the normal size after a drag, with a small elastic overshoot. */
  .node-avatar.unzoom .ring {
    transition:
      scale 600ms cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color var(--dur-fast) linear,
      box-shadow 200ms var(--ease-out);
  }
  /* Easter egg: a click makes the portrait pulse and sends a ring outwards. */
  .node-avatar .ring {
    position: relative;
  }
  .node-avatar .ring::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--accent-graph);
    opacity: 0;
    pointer-events: none;
  }
  .node-avatar.pulse .ring {
    animation: pulse 520ms var(--ease-out);
  }
  .node-avatar.pulse .ring::after {
    animation: ripple 900ms var(--ease-out);
  }
  @keyframes pulse {
    30% {
      transform: scale(0.94);
    }
    65% {
      transform: scale(1.04);
    }
  }
  /* Easter egg: the portrait breaks. It shakes and flickers. */
  .node-avatar.broken .ring {
    animation: shake 650ms linear;
  }
  @keyframes shake {
    10% { transform: translate(-3px, 1px) rotate(-2deg); filter: brightness(1.4); }
    20% { transform: translate(3px, -2px) rotate(2deg); filter: brightness(0.7); }
    30% { transform: translate(-4px, 0) rotate(-1deg); filter: brightness(1.2); }
    40% { transform: translate(4px, 2px) rotate(1.5deg); filter: brightness(0.8); }
    55% { transform: translate(-2px, -1px) rotate(-1deg); filter: brightness(1.1); }
    70% { transform: translate(2px, 1px) rotate(0.5deg); filter: none; }
    85% { transform: translate(-1px, 0); }
  }
  @keyframes ripple {
    from {
      opacity: 0.9;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.45);
    }
  }

  .node-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
  }
  /* Each link keeps its own colour (data-tone), set when a colour wave reaches it. */
  .node-link {
    --node-accent: var(--tone-lime);
  }
  .node-link[data-tone='cyan'] {
    --node-accent: var(--tone-cyan);
  }
  .node-link[data-tone='magenta'] {
    --node-accent: var(--tone-magenta);
  }
  .node-link .ring {
    width: 3.5rem;
    height: 3.5rem;
    border: 1.5px solid var(--node-accent);
    color: var(--ink);
  }
  .node-link .ring :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
  }
  /* The label hangs below the circle so the circle's centre stays on the graph. */
  .node-link .label {
    position: absolute;
    top: calc(100% + var(--s-2));
    display: grid;
    justify-items: center;
    padding: 0 var(--s-2);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    backdrop-filter: blur(3px);
    white-space: nowrap;
    line-height: 1.4;
  }
  .node-link .name {
    color: var(--ink);
    font-weight: 500;
  }
  .node-link .handle {
    color: var(--muted);
  }
  .node-li {
    --x: 78%;
    --y: 22%;
  }
  .node-gh {
    --x: 60%;
    --y: 72%;
  }
  @media (min-width: 56rem) {
    .node-avatar {
      --x: 46%;
      --y: 50%;
    }
    .node-li {
      --x: 90%;
      --y: 16%;
    }
    .node-gh {
      --x: 86%;
      --y: 82%;
    }
  }
  @media (hover: hover) {
    .node-link:hover .ring {
      color: var(--node-accent);
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--node-accent) 18%, transparent);
    }
    .node-avatar:hover .ring {
      box-shadow: 0 0 0 10px color-mix(in srgb, var(--accent-graph) 16%, transparent);
    }
  }
  .node:focus-visible {
    outline: none;
  }
  .node:focus-visible .ring {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  /* Area icons: gray, smaller and quieter than the links. The script sets --x/--y
     (page pixels); until then, or when there is no room, they stay hidden. */
  .areas {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .node-area {
    visibility: hidden;
    pointer-events: auto;
    cursor: grab;
  }
  /* Set by the graph script while a node is being dragged. */
  :global(html.is-dragging),
  :global(html.is-dragging *) {
    cursor: grabbing !important;
    user-select: none;
  }
  .node-area[data-placed] {
    visibility: visible;
  }
  /* --pulse (0%..100%) and --pulse-color are set by the graph script while a colour
     wave passes through the icon. */
  .node-area .ring {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--pulse-color, var(--accent-graph)) var(--pulse, 0%), var(--line));
    color: color-mix(in srgb, var(--pulse-color, var(--accent)) var(--pulse, 0%), var(--muted));
    transition: none;
  }
  .node-area .ring :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }
  .node-area .label {
    position: absolute;
    top: calc(100% + var(--s-1));
    left: 50%;
    translate: -50% 0;
    padding: 0 var(--s-2);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    white-space: nowrap;
    color: var(--muted);
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }
  @media (hover: hover) {
    /* Hover takes the current accent; once the portrait has broken and everything
